# Bitcoin Trading Bot - 환경 변수 템플릿
# 이 파일을 .env로 복사하여 사용하세요
# cp .env.example .env

# ============================================================
# 텔레그램 알림 (필수)
# ============================================================
# 봇 생성: @BotFather에서 /newbot
# Chat ID 확인: python live_trading/get_chat_id.py
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id
TELEGRAM_NOTIFY_SELECTOR_EVENTS=false
TELEGRAM_NOTIFY_ORDER_REJECTED=true
TELEGRAM_NOTIFY_UNKNOWN_EXECUTOR_ALERTS=false
TELEGRAM_SYSTEM_ALERT_MIN_LEVEL=CRITICAL
TELEGRAM_NOTIFY_STARTUP=true

# ============================================================
# 바이낸스 선물 API (필수)
# ============================================================
# 발급: https://www.binance.com → API Management
# 권한: Futures
BINANCE_API_KEY=your_binance_api_key
BINANCE_API_SECRET=your_binance_secret_key

# ============================================================
# 거래 설정
# ============================================================
# 자동 거래 활성화 (True: 실거래, False: 알림만)
AUTO_TRADE=False

# 초기 자본 (KRW, 선택)
INITIAL_CAPITAL=10000000

# ============================================================
# 대시보드 설정
# ============================================================
# 대시보드 비밀 경로 (URL 유추 방지)
# 예: my-secret-dashboard-2024 → http://서버:8081/my-secret-dashboard-2024
DASHBOARD_SECRET_PATH=your_secret_path_here
