    "bear_short_btc": {
      "_comment": "BTC futures short - DISABLED: negative returns across all assets",
      "enabled": false,
      "market": "futures",
      "leverage": 3,
      "position_pct": 0.1,
      "position_size": 0.01,
      "symbols": ["BTC"],
      "entry": {
        "class": "BearShortEntryStrategy",
        "params": {
          "volume_ratio_threshold": 0,
          "position_size": 0.01,
          "ema200_filter": true,
          "rsi_max": 35,
          "min_consecutive_bear": 2
        }
      },
      "exit": {
        "class": "BearShortExitStrategy",
        "params": {
          "stop_loss_pct": 3.0,
          "take_profit_pct": 6.0,
          "trailing_enabled": true,
          "trailing_activation": 2.0,
          "trailing_distance": 1.5
