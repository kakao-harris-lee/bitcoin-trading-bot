{
  "redis_url": "redis://localhost:6379",
  "use_component_strategies": true,
  "symbols": [
    "BTC",
    "ETH",
    "SOL"
  ],
  "defaults": {
    "volatility": {
      "window": 20,
      "low_threshold": 0.71,
      "high_threshold": 0.92,
      "extreme_threshold": 0.03
    },
    "volume": {
      "high_volume_multiplier": 1.5
    },
    "market_context": {
      "mfi_bull": 52.0,
      "mfi_bear": 48.0,
      "adx_trend": 20.0
    },
    "regime_v2": {
      "_comment": "Enhanced regime detection v2 filter defaults",
      "bbw_block_threshold": 25,
      "bbw_confirm_threshold": 50,
      "volume_block_ratio": 0.8,
      "volume_boost_ratio": 1.2,
      "mtf_enabled": true
    }
  },
  "binance": {
    "api_key": "${BINANCE_API_KEY}",
    "api_secret": "${BINANCE_API_SECRET}"
  },
  "futures": {
    "enabled": true,
    "default_leverage": 3
  },
  "strategies": {
    "v35_long": {
      "market": "futures",
      "leverage": 3,
      "dynamic_sizing": true,
      "position_pct": 0.3,
      "position_size": 0.01,
      "use_smart_exit": true,
      "use_breakout_filter": true,
      "regime_version": "v1"
    },
    "v35_long_v2": {
      "_comment": "Dynamic position sizing based on RF confidence",
      "market": "futures",
      "leverage": 3,
      "dynamic_sizing": true,
      "position_pct": 0.3,
      "position_size": 0.01,
      "use_smart_exit": true,
      "use_breakout_filter": false,
      "regime_version": "v2",
      "bbw_block_threshold": 0,
      "bbw_confirm_threshold": 0,
      "volume_block_ratio": 0.0,
      "volume_boost_ratio": 1.0,
      "mtf_enabled": false,
      "stop_loss_cooldown": 6,
      "trailing_enabled": true,
      "trailing_activation": 2.0,
      "trailing_distance": 1.0,
      "atr_stop_enabled": true,
      "atr_stop_multiplier": 3.5,
      "atr_stop_min_pct": 3.0,
      "atr_stop_max_pct": 5.0,
      "dynamic_leverage": true,
      "leverage_bull_strong": 3.0,
      "leverage_bull_moderate": 2.0,
      "leverage_sideways": 0.5,
      "leverage_bear": 1.0,
      "cash_in_bear": true,
      "cash_below_ema200": false,
      "max_consecutive_losses": 2,
      "loss_pause_candles": 60,
      "drawdown_enabled": false,
      "drawdown_warning_pct": 8.0,
      "drawdown_reduce_pct": 10.0,
      "drawdown_exit_pct": 12.0,
      "v2_exit_on_filter": false,
      "bull_prob_threshold": 0.0,
      "panic_sell_below_ma120": false,
      "use_rf_probability": true,
      "lstm_model_path": "lstm_trainer/models/hybrid_lstm.pth",
      "rf_model_path": "lstm_trainer/models/noise_filter_rf.pkl",
      "dynamic_position_sizing": false,
      "position_size_high": 0.30,
      "position_size_mid": 0.15,
      "position_size_low": 0.05,
      "position_conf_low": 0.50,
      "position_conf_high": 0.70
    },
    "combo_ensemble": {
      "market": "futures",
      "leverage": 3,
      "dynamic_sizing": true,
      "position_pct": 0.3,
      "position_size": 0.01,
      "use_smart_exit": true,
      "entry": {
        "class": "CombinedEntryStrategy"
      },
      "exit": {
        "class": "CombinedExitStrategy"
      }
    }
  },
  "smart_executor": {
    "enabled": true,
    "trailing": {
      "volatility_window": 20,
      "low_vol_trail": 0.8,
      "med_vol_trail": 1.2,
      "high_vol_trail": 1.8,
      "damping_max": 0.2
    },
    "split_execution": {
      "ladder_tiers": [
        0.05,
        0.12,
        0.2
      ],
      "ladder_weights": [
        0.4,
        0.35,
        0.25
      ],
      "phase1_timeout_sec": 75,
      "max_execution_sec": 105
    }
  },
  "risk": {
    "max_daily_loss": 500
  },
  "paper": {
    "initial_balance": 10000,
    "fee_rate": 0.001,
    "slippage": 0.0004
  },
  "observability": {
    "emit_events": false
  }
}