  "smart_executor": {
    "enabled": true,
    "trailing": {
      "volatility_window": 20,
      "low_vol_trail": 0.8,
      "med_vol_trail": 1.2,
      "high_vol_trail": 1.8,
      "damping_max": 0.2
    },
    "split_execution": {
      "ladder_tiers": [
        0.05,
        0.12,
        0.2
      ],
      "ladder_weights": [
        0.4,
        0.35,
        0.25
      ],
      "phase1_timeout_sec": 75,
      "max_execution_sec": 105
    }
  },
  "risk": {
    "max_daily_loss": 500
  },
  "paper": {
    "initial_balance": 10000,
    "fee_rate": 0.001,
    "slippage": 0.0004
