{
  "redis_url": "redis://localhost:6379",
  "use_component_strategies": true,
  "symbols": [
    "BTC",
    "ETH",
    "SOL",
    "BNB"
  ],
  "defaults": {
    "volatility": {
      "window": 20,
      "low_threshold": 0.71,
      "high_threshold": 0.92,
      "extreme_threshold": 0.03
    },
    "volume": {
      "high_volume_multiplier": 1.5
    },
    "market_context": {
      "mfi_bull": 52.0,
      "mfi_bear": 48.0,
      "adx_trend": 20.0
    },
    "regime_v2": {
      "_comment": "Enhanced regime detection v2 filter defaults",
      "bbw_block_threshold": 25,
      "bbw_confirm_threshold": 50,
      "volume_block_ratio": 0.8,
      "volume_boost_ratio": 1.2,
      "mtf_enabled": true
    }
  },
  "binance": {
    "api_key": "${BINANCE_API_KEY}",
    "api_secret": "${BINANCE_API_SECRET}"
  },
  "futures": {
    "enabled": false,
    "default_leverage": 3
  },
  "spot": {
    "enabled": true,
    "fee_rate": 0.001
  },
  "strategies": {
    "mlp_direction_btc": {
      "_comment": "Paper reproduction - BTC model (BWin=5, FWin=2)",
      "enabled": true,
      "market": "spot",
      "volatility_sizing": {
        "enabled": true,
        "target_vol": 0.03,
        "min_scale": 0.25,
        "max_scale": 1.0
      },
      "symbols": [
        "BTC"
      ],
      "bwin": 5,
      "mlp_feature_set": "paper_36",
      "model_path": "models/mlp_direction/btc_bwin5_fwin2/model_final.pt",
      "position_pct": 0.9,
      "position_size": 0.9,
      "drawdown_enabled": false,
      "stop_loss_cooldown": 0,
      "drawdown_bear_threshold": 1.0,
      "entry": {
        "class": "MLPDirectionEntryStrategy",
        "params": {
          "model_path": "models/mlp_direction/btc_bwin5_fwin2/model_final.pt",
          "buy_confidence_threshold": 0.0,
          "skip_bear_regime": true,
          "adx_min": 0.0,
          "use_ema200_filter": false,
          "position_size": 0.9,
          "market": "spot",
          "mlp_feature_set": "paper_36"
        }
      },
      "exit": {
        "class": "MLPDirectionExitStrategy",
        "params": {
          "stop_loss_pct": 10.0,
          "fwin_exit_enabled": false,
          "fwin_periods": 2,
          "atr_stop_enabled": false,
          "trailing_enabled": false,
          "take_profit_enabled": false,
          "use_mlp_sell_exit": true,
          "sell_confidence_threshold": 0.0,
          "model_path": "models/mlp_direction/btc_bwin5_fwin2/model_final.pt",
          "market": "spot",
          "mlp_feature_set": "paper_36"
        }
      }
    },
