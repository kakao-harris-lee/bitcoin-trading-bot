{
  "strategy_name": "combo_ensemble",
  "version": "v1",
  "timeframe": "minute60",
  "description": "Combined strategy: volatility breakout + LSTM trend + MA cross",
  "market": "futures",
  "position_size": 0.1,
  "entry": {
    "class": "CombinedEntryStrategy",
    "params": {
      "breakout_k": 0.3,
      "require_up_close": true,
      "require_lstm": true,
      "lstm_model_path": "models/trading_lstm_price.pth",
      "lstm_seq_len": 120,
      "lstm_price_buffer_pct": -0.01,
      "lstm_hidden_size": 96,
      "lstm_num_layers": 2,
      "lstm_dropout": 0.2,
      "ema_fast": 20,
      "ema_slow": 50,
      "ma_confirm_required": false
    }
  },
  "exit": {
    "class": "CombinedExitStrategy",
    "params": {
      "exit_at_day_close": true,
      "max_hold_hours": 12.0,
      "take_profit_pct": 3.0,
      "stop_loss_pct": 1.5
    }
  }
}
